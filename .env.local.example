NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# --- Wallet (ces valeurs restent SECRÈTES : ne jamais les commiter ni les mettre dans NEXT_PUBLIC_) ---
# Supabase → Project Settings → API → clé "service_role"
SUPABASE_SERVICE_ROLE_KEY=
# Stripe → Développeurs → Clés API (clé secrète de test : sk_test_...)
STRIPE_SECRET_KEY=
# Secret du webhook (whsec_...) : fourni par "stripe listen" en local, ou par le tableau de bord en production
STRIPE_WEBHOOK_SECRET=

# --- Wallet (non secret) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WALLET_CURRENCY=eur
